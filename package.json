{
  "name": "vite-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "bun --cwd server run dev",
    "build": "node ./node_modules/@typescript/native/bin/tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fix": "prettier --write . && eslint . --fix",
    "preview": "vite preview",
    "i18n:extract": "lingui extract --clean",
    "i18n:compile": "lingui compile --strict && bun scripts/generate-message-ids.ts",
    "i18n:compile:watch": "lingui compile --watch",
    "i18n:check": "lingui extract --clean && lingui compile --strict",
    "prepare": "husky"
  },
  "dependencies": {
    "@lingui/core": "^6.10.0",
    "@lingui/react": "^6.10.0",
    "@tanstack/react-router": "^1.170.23",
    "@ton/core": "^0.63.1",
    "@tonconnect/ui-react": "^3.0.2",
    "axios": "^1.20.0",
    "buffer": "^6.0.3",
    "effector": "^23.4.4",
    "effector-react": "^23.3.0",
    "lucide-react": "^1.61.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lingui/babel-plugin-lingui-macro": "^6.10.0",
    "@lingui/cli": "^6.10.0",
    "@lingui/format-po": "6.10.1",
    "@lingui/vite-plugin": "^6.10.0",
    "@tanstack/router-plugin": "^1.168.27",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.13.0",
    "eslint-plugin-perfectionist": "^5.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "msw": "2",
    "prettier": "3.8.3",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-node-polyfills": "^0.28.0"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.json": [
      "prettier --write"
    ]
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
